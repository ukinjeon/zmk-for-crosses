#include <dt-bindings/zmk/matrix_transform.h>
#include "physical_layouts.dtsi"

/ {
    crosses_layout: crosses_layout {
        compatible = "zmk,crosses-layout";
        display-name = "crosses";

        kscan = <&kscan0>;
        transform = <&matrix_transform0>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  825    0       0     0     0>
            , <&key_physical_attrs 100 100  300   25       0     0     0>
            , <&key_physical_attrs 100 100  400   25       0     0     0>
            , <&key_physical_attrs 100 100  625   25       0     0     0>
            , <&key_physical_attrs 100 100  725   25       0     0     0>
            , <&key_physical_attrs 100 100  100   50       0     0     0>
            , <&key_physical_attrs 100 100  925   50       0     0     0>
            , <&key_physical_attrs 100 100    0  100       0     0     0>
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  825  100       0     0     0>
            , <&key_physical_attrs 100 100 1025  100       0     0     0>
            , <&key_physical_attrs 100 100  300  125       0     0     0>
            , <&key_physical_attrs 100 100  400  125       0     0     0>
            , <&key_physical_attrs 100 100  625  125       0     0     0>
            , <&key_physical_attrs 100 100  725  125       0     0     0>
            , <&key_physical_attrs 100 100  100  150       0     0     0>
            , <&key_physical_attrs 100 100  925  150       0     0     0>
            , <&key_physical_attrs 100 100    0  200       0     0     0>
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  825  200       0     0     0>
            , <&key_physical_attrs 100 100 1025  200       0     0     0>
            , <&key_physical_attrs 100 100  300  225       0     0     0>
            , <&key_physical_attrs 100 100  400  225       0     0     0>
            , <&key_physical_attrs 100 100  625  225       0     0     0>
            , <&key_physical_attrs 100 100  725  225       0     0     0>
            , <&key_physical_attrs 100 100  100  250       0     0     0>
            , <&key_physical_attrs 100 100  925  250       0     0     0>
            , <&key_physical_attrs 100 100    0  300       0     0     0>
            , <&key_physical_attrs 100 100 1025  300       0     0     0>
            , <&key_physical_attrs 100 100  225  375       0     0     0>
            , <&key_physical_attrs 100 100  325  375       0     0     0>
            , <&key_physical_attrs 100 100  425  375       0     0     0>
            , <&key_physical_attrs 100 100  600  375       0     0     0>
            , <&key_physical_attrs 100 100  700  375       0     0     0>
            , <&key_physical_attrs 100 100  800  375       0     0     0>
            ;
    };


    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &crosses_layout;
    };

    default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)               RC(0,9) RC(0,8) RC(0,7) RC(0,6) RC(0,5) 
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)               RC(1,9) RC(1,8) RC(1,7) RC(1,6) RC(1,5)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)               RC(2,9) RC(2,8) RC(2,7) RC(2,6) RC(2,5)
			                RC(3,2) RC(3,3) RC(3,4)               RC(3,9) RC(3,8) RC(3,7)           
     >;
};
	
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";

        diode-direction = "row2col";
		row-gpios
            = <&gpio0 2 GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>
	        , <&gpio0 11 GPIO_ACTIVE_HIGH>
	      
            ;
    };
 
};


&crosses_layout{

	transform = <&default_transform>;

	kscan = <&kscan0>;

};
