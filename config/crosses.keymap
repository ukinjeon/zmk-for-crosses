#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

#define EN 0
#define KO 1
#define NUM 2
#define NAV 3
#define FUN 4
#define MOUSE 5

#define SHORTCUT_MODS (MOD_LCTL|MOD_RCTL|MOD_LALT|MOD_RALT|MOD_LGUI|MOD_RGUI)

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&trackball_peripheral_split {
    input-processors
        = <&zip_xy_to_scroll_mapper>
        , <&zip_scroll_scaler 1 6>
        ;
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        td_r1: td_r1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_R1";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&sk>;
        };

        ko_kp: ko_kp {
            compatible = "zmk,behavior-key-press";
            label = "KO_KEY_PRESS";
            #binding-cells = <1>;
        };

        ko_mt: ko_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        ko_lt: ko_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        lang_to_ko: lang_to_ko {
            compatible = "zmk,behavior-macro";
            label = "LANG_TO_KO";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(SPACE)>, <&macro_tap &to KO>;
        };

        lang_to_en: lang_to_en {
            compatible = "zmk,behavior-macro";
            label = "LANG_TO_EN";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(SPACE)>, <&macro_tap &to EN>;
        };

        ko_yeo: ko_yeo {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YEO";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp U>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_ya: ko_ya {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YA";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp I>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_yu: ko_yu {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YU";
            #binding-cells = <0>;
            bindings = <&kp N>, <&kp B>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_yo: ko_yo {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YO";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp Y>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_f_c: ko_f_c {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp F>, <&kp C>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_h_z: ko_h_z {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp G>, <&kp Z>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
