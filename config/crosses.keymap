        ko_ya_mt: ko_ya_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_YA_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&ko_ya_k>;
        };

        ko_yo_mt: ko_yo_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_YO_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
