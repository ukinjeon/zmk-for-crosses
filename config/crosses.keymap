    conditional_layers {
        compatible = "zmk,conditional-layers";

        ko_shortcuts {
            if-layers = <KO>;
            then-layer = <SHORTCUT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        En {
            bindings = <
&en_sqt_q      &en_b_w     &en_h_e     &en_g_r     &en_dqt_t         &en_slash_y     &en_dot_u      &en_comma_i   &en_semi_o    &en_bslash_p
&en_c_a_mt LGUI 0 &mt LALT S &en_n_d_mt LCTL 0 &en_t_f_mt LSFT 0 &en_k_g_lt MOUSE 0 &en_w_h_lt MOUSE 0 &en_a_j_mt RSFT 0 &en_e_k_mt RCTL 0 &en_i_l_mt RALT 0 &en_m_semi_mt RGUI 0
&en_equal_z    &en_f_x     &en_l_c     &en_d_v     &en_v_b           &en_minus_n     &en_u_m        &en_o_comma   &en_y_dot     &en_j_slash
                           &kp ESCAPE  &lt NUM R    &lt NAV TAB        &td_r1 FUN LEFT_SHIFT &lt MOUSE SPACE &kp BACKSPACE
            >;
        };

        Ko {
            bindings = <
&kp SQT           &ko_kp A       &ko_kp Q       &ko_kp C       &kp LS(SQT)           &kp SLASH       &kp DOT        &kp COMMA       &kp SEMICOLON &kp BACKSLASH
&ko_mt LGUI X     &ko_mt LALT S  &ko_mt LCTL D  &ko_mt LSFT F  &ko_lt MOUSE T       &ko_lt MOUSE P  &ko_yeo_mt RSFT 0 &ko_ya_mt RCTL 0 &ko_yo_mt RALT 0 &ko_mt RGUI O
&kp EQUAL         &ko_kp W       &ko_kp E       &ko_kp G       &ko_kp Z              &kp MINUS       &ko_kp L      &ko_kp M         &ko_yu          &ko_kp V
                               &kp ESCAPE     &ko_lt NUM R   &lt NAV TAB          &td_r1 FUN LEFT_SHIFT &lt MOUSE SPACE &kp BACKSPACE
            >;
        };

        Shortcuts {
            bindings = <
&sc_q       &sc_w       &sc_e       &sc_r       &sc_t           &sc_y       &sc_u       &sc_i       &sc_o       &sc_p
&sc_a       &sc_s       &sc_d       &sc_f       &sc_g           &sc_h       &sc_j       &sc_k       &sc_l       &sc_semi
&sc_z       &sc_x       &sc_c       &sc_v       &sc_b           &sc_n       &sc_m       &sc_comma   &sc_dot     &sc_slash
                        &trans      &trans      &trans          &trans      &trans      &trans
            >;
        };

        Num {
            bindings = <
&kp LEFT_BRACKET     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET     &none          &kp LS(N7)     &kp LS(N8)    &kp LS(N9)     &none
&kp LS(LEFT_BRACKET) &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(RIGHT_BRACKET) &kp GRAVE      &kp LS(N4)     &kp LS(N5)    &kp LS(N6)     &kp BACKSLASH
&kp LS(N9)           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(N0)            &kp LS(GRAVE)  &kp LS(N1)     &kp LS(N2)    &kp LS(N3)     &kp LS(BACKSLASH)
                                  &none         &none         &none                  &none          &none          &none
            >;
        };

        Nav {
            bindings = <
&kp LC(Q)   &kp LC(W)  &kp LG(E)  &kp LC(R)  &kp LC(T)       &kp CAPSLOCK   &kp DELETE      &kp INSERT      &kp PRINTSCREEN  &kp PAUSE_BREAK
&kp LC(A)   &kp LC(S)  &kp LG(D)  &kp LC(F)  &kp LG(G)       &kp PG_UP      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW
&kp LC(Z)   &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LG(B)       &kp PG_DN      &none           &none           &none            &none
                      &none      &none      &none            &kp HOME       &kp END         &none
            >;
        };

        Fun {
            bindings = <
&none  &kp F7  &kp F8  &kp F9  &kp F12       &none  &none  &none  &none  &none
&none  &kp F4  &kp F5  &kp F6  &kp F11       &none  &none  &none  &none  &none
&none  &kp F1  &kp F2  &kp F3  &kp F10       &none  &none  &none  &none  &none
              &none   &none   &none          &none  &none  &none
            >;
        };

        Mouse {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR      &bt BT_CLR      &bootloader &sys_reset &none       &none
&to EN        &kp LC(SPACE) &to KO        &none         &none           &none           &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
&trans        &none         &none         &none         &none           &studio_unlock  &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
                            &mkp MCLK     &mkp LCLK     &mkp RCLK       &mkp RCLK       &mkp LCLK  &mkp MCLK
            >;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_en_snt_enter {
            timeout-ms = <50>;
            key-positions = <11 12 13>;
            layers = <EN>;
            bindings = <&kp ENTER>;
        };

        combo_en_bh_w {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <EN>;
            bindings = <&kp W>;
        };

        combo_en_fl_x {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <EN>;
            bindings = <&kp X>;
        };

        combo_en_ld_p {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <EN>;
            bindings = <&kp P>;
        };

        combo_en_hg_q {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <EN>;
            bindings = <&kp Q>;
        };

        combo_en_cs_z {
            timeout-ms = <50>;
            key-positions = <10 11>;
            layers = <EN>;
            bindings = <&kp Z>;
        };

        combo_ko_mb_p {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <KO SHORTCUT>;
            bindings = <&ko_kp V>;
        };

        combo_en_ko_home_left_click {
            timeout-ms = <50>;
            key-positions = <16 17>;
            layers = <EN KO SHORTCUT>;
            bindings = <&mkp LCLK>;
        };

        combo_en_ko_home_right_click {
            timeout-ms = <50>;
            key-positions = <17 18>;
            layers = <EN KO SHORTCUT>;
            bindings = <&mkp RCLK>;
        };

        combo_ko_home_enter {
            timeout-ms = <50>;
            key-positions = <11 12 13>;
            layers = <KO SHORTCUT>;
            bindings = <&kp ENTER>;
        };

        combo_en_lang_to_ko {
            timeout-ms = <70>;
            key-positions = <30 35>;
            layers = <EN>;
            bindings = <&lang_to_ko>;
        };

        combo_ko_lang_to_en {
            timeout-ms = <70>;
            key-positions = <30 35>;
            layers = <KO SHORTCUT>;
            bindings = <&lang_to_en>;
        };

        combo_os_language_toggle {
            timeout-ms = <70>;
            key-positions = <30 34>;
            layers = <EN KO SHORTCUT>;
            bindings = <&kp LC(SPACE)>;
        };

        combo_en_layer_to_ko {
            timeout-ms = <70>;
            key-positions = <32 35>;
            layers = <EN>;
            bindings = <&to KO>;
        };

        combo_ko_layer_to_en {
            timeout-ms = <70>;
            key-positions = <32 35>;
            layers = <KO SHORTCUT>;
            bindings = <&to EN>;
        };

        combo_num_12_0 {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <NUM>;
            bindings = <&kp NUMBER_0>;
        };

        combo_num_23_dot {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <NUM>;
            bindings = <&kp DOT>;
        };

        combo_num_45_minus {
            timeout-ms = <50>;
            key-positions = <11 12>;
            layers = <NUM>;
            bindings = <&kp MINUS>;
        };

        combo_num_56_plus {
            timeout-ms = <50>;
            key-positions = <12 13>;
            layers = <NUM>;
            bindings = <&kp LS(EQUAL)>;
        };

        combo_num_78_slash {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <NUM>;
            bindings = <&kp SLASH>;
        };

        combo_num_89_asterisk {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <NUM>;
            bindings = <&kp LS(NUMBER_8)>;
        };
    };
 
};
