            label = "KO_YO_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&ko_yo>;
        };

        ko_yeo_mt: ko_yeo_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_YEO_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
