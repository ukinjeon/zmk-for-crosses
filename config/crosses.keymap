#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/pointing.h>

#define CUSTOM 0
#define QWERTY 1
#define HYBRID 2
#define SVAL_KO 3
#define NUM 4
#define NAV 5
#define FUN 6
#define MOUSE 7

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <150>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&trackball_peripheral_split {
    input-processors
        = <&zip_xy_to_scroll_mapper>
        , <&zip_scroll_scaler 1 6>
        ;
};

/ {
    chosen { zmk,physical-layout = &gggw_crosses_36_layout; };

    behaviors {
        td_r1: td_r1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TD_R1";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&mo>, <&sk>;
        };

        ko_kp: ko_kp {
            compatible = "zmk,behavior-key-press";
            label = "KO_KEY_PRESS";
            #binding-cells = <1>;
        };

        ko_mt: ko_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        ko_lt: ko_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_LAYER_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        lang_to_ko: lang_to_ko {
            compatible = "zmk,behavior-macro";
            label = "LANG_TO_KO";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(SPACE)>, <&macro_tap &to SVAL_KO>;
        };

        lang_to_en: lang_to_en {
            compatible = "zmk,behavior-macro";
            label = "LANG_TO_EN";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(SPACE)>, <&macro_tap &to HYBRID>;
        };

        ko_yeo: ko_yeo {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YEO";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp U>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_ya: ko_ya {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YA";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp I>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_yu: ko_yu {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YU";
            #binding-cells = <0>;
            bindings = <&kp N>, <&kp B>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_yo: ko_yo {
            compatible = "zmk,behavior-mod-morph";
            label = "KO_YO";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp Y>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ko_ya_mt: ko_ya_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_YA_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&ko_ya>;
        };

        ko_yo_mt: ko_yo_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "KO_YO_MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
            quick-tap-ms = <150>;
            bindings = <&kp>, <&ko_yo>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Custom {
            bindings = <
&kp SQT        &kp B       &kp H       &kp G       &kp LS(SQT)       &kp SLASH       &kp COMMA      &kp DOT       &kp J       &kp X
&mt LGUI C     &mt LALT S  &mt LCTL N  &mt LSFT T  &lt MOUSE K       &lt FUN SEMICOLON &mt RSFT A     &mt RCTL E    &mt RALT I    &mt RGUI M
&kp EQUAL      &kp F       &kp L       &kp D       &kp V             &kp MINUS       &kp U          &kp O         &kp Y       &kp W
                           &kp ESCAPE  &lt NUM R    &lt NAV TAB        &td_r1 FUN LEFT_SHIFT &lt MOUSE SPACE &kp BACKSPACE
            >;
        };

        Qwerty {
            bindings = <
&kp Q          &kp W       &kp E       &kp R       &kp T             &kp Y           &kp U          &kp I         &kp O       &kp P
&mt LGUI A     &mt LALT S  &mt LCTL D  &mt LSFT F  &lt MOUSE G       &lt FUN H        &mt RSFT J     &mt RCTL K    &mt RALT L    &mt RGUI SEMICOLON
&kp Z          &kp X       &kp C       &kp V       &kp B             &kp N           &kp M          &kp COMMA     &kp DOT     &kp SLASH
                           &kp ESCAPE  &lt NUM R    &lt NAV TAB        &td_r1 FUN LEFT_SHIFT &lt MOUSE SPACE &kp BACKSPACE
            >;
        };

        HybridEn {
            bindings = <
&kp SQT        &kp B       &kp H       &kp G       &kp LS(SQT)       &kp SLASH       &kp DOT        &kp COMMA     &kp SEMICOLON &kp BACKSLASH
&mt LGUI C     &mt LALT S  &mt LCTL N  &mt LSFT T  &lt MOUSE K       &lt MOUSE W      &mt RSFT A     &mt RCTL E    &mt RALT I    &mt RGUI M
&kp EQUAL      &kp F       &kp L       &kp D       &kp V             &kp MINUS       &kp U          &kp O         &kp Y       &kp J
                           &kp ESCAPE  &lt NUM R    &lt NAV TAB        &td_r1 FUN LEFT_SHIFT &lt MOUSE SPACE &kp BACKSPACE
            >;
        };

        SvalKo {
            bindings = <
&kp SQT           &ko_kp V       &ko_kp Z       &ko_kp A       &kp LS(SQT)           &kp SLASH       &kp DOT        &kp COMMA     &kp SEMICOLON &kp BACKSLASH
&ko_mt LGUI G     &ko_mt LALT S  &ko_mt LCTL D  &ko_mt LSFT E  &ko_lt MOUSE T       &ko_lt MOUSE P  &ko_mt RSFT L  &ko_mt RCTL M &ko_ya_mt RALT 0 &ko_yo_mt RGUI 0
&kp EQUAL         &ko_kp F       &ko_kp Q       &ko_kp W       &ko_kp C             &kp MINUS       &ko_kp O       &ko_yeo       &ko_yu        &ko_kp X
                               &kp ESCAPE     &ko_lt NUM R   &lt NAV TAB          &td_r1 FUN LEFT_SHIFT &lt MOUSE SPACE &kp BACKSPACE
            >;
        };

        Num {
            bindings = <
&kp LEFT_BRACKET     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp RIGHT_BRACKET     &none          &kp LS(N7)     &kp LS(N8)    &kp LS(N9)     &none
&kp LS(LEFT_BRACKET) &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(RIGHT_BRACKET) &kp GRAVE      &kp LS(N4)     &kp LS(N5)    &kp LS(N6)     &kp BACKSLASH
&kp LS(N9)           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(N0)            &kp LS(GRAVE)  &kp LS(N1)     &kp LS(N2)    &kp LS(N3)     &kp LS(BACKSLASH)
                                  &none         &none         &none                  &none          &none          &none
            >;
        };

        Nav {
            bindings = <
&kp LC(Q)   &kp LC(W)  &kp LG(E)  &kp LC(R)  &kp LC(T)       &kp CAPSLOCK   &kp DELETE      &kp INSERT      &kp PRINTSCREEN  &kp PAUSE_BREAK
&kp LC(A)   &kp LC(S)  &kp LG(D)  &kp LC(F)  &kp LG(G)       &kp PG_UP      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW     &kp RIGHT_ARROW
&kp LC(Z)   &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LG(B)       &kp PG_DN      &none           &none           &none            &none
                      &none      &none      &none            &kp HOME       &kp END         &none
            >;
        };

        Fun {
            bindings = <
&none  &kp F7  &kp F8  &kp F9  &kp F12       &none  &none  &none  &none  &none
&none  &kp F4  &kp F5  &kp F6  &kp F11       &none  &none  &none  &none  &none
&none  &kp F1  &kp F2  &kp F3  &kp F10       &none  &none  &none  &none  &none
              &none   &none   &none          &none  &none  &none
            >;
        };

        Mouse {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR      &bt BT_CLR      &bootloader &sys_reset &to QWERTY  &to CUSTOM
&to HYBRID    &kp LC(SPACE) &to SVAL_KO   &none         &none           &none           &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
&trans        &none         &none         &none         &none           &studio_unlock  &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
                            &mkp MCLK     &mkp LCLK     &mkp RCLK       &mkp RCLK       &mkp LCLK  &mkp MCLK
            >;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_custom_snt_enter {
            timeout-ms = <50>;
            key-positions = <11 12 13>;
            layers = <CUSTOM HYBRID>;
            bindings = <&kp ENTER>;
        };

        combo_qwerty_sdf_enter {
            timeout-ms = <50>;
            key-positions = <11 12 13>;
            layers = <QWERTY>;
            bindings = <&kp ENTER>;
        };

        combo_custom_bh_w {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <CUSTOM HYBRID>;
            bindings = <&kp W>;
        };

        combo_custom_fl_x {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <CUSTOM HYBRID>;
            bindings = <&kp X>;
        };

        combo_custom_ld_p {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <CUSTOM HYBRID>;
            bindings = <&kp P>;
        };

        combo_custom_hg_q {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <CUSTOM HYBRID>;
            bindings = <&kp Q>;
        };

        combo_custom_cs_z {
            timeout-ms = <50>;
            key-positions = <10 11>;
            layers = <CUSTOM HYBRID>;
            bindings = <&kp Z>;
        };

        combo_ko_pk_ch {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <SVAL_KO>;
            bindings = <&kp C>;
        };

        combo_ko_km_t {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <SVAL_KO>;
            bindings = <&kp X>;
        };

        combo_ko_nod_enter {
            timeout-ms = <50>;
            key-positions = <11 12 13>;
            layers = <SVAL_KO>;
            bindings = <&kp ENTER>;
        };

        combo_hybrid_lang_to_ko {
            timeout-ms = <70>;
            key-positions = <30 35>;
            layers = <HYBRID>;
            bindings = <&lang_to_ko>;
        };

        combo_sval_lang_to_en {
            timeout-ms = <70>;
            key-positions = <30 35>;
            layers = <SVAL_KO>;
            bindings = <&lang_to_en>;
        };

        combo_os_language_toggle {
            timeout-ms = <70>;
            key-positions = <30 34>;
            layers = <HYBRID SVAL_KO>;
            bindings = <&kp LC(SPACE)>;
        };

        combo_hybrid_layer_to_ko {
            timeout-ms = <70>;
            key-positions = <32 35>;
            layers = <HYBRID>;
            bindings = <&to SVAL_KO>;
        };

        combo_sval_layer_to_en {
            timeout-ms = <70>;
            key-positions = <32 35>;
            layers = <SVAL_KO>;
            bindings = <&to HYBRID>;
        };

        combo_num_12_0 {
            timeout-ms = <50>;
            key-positions = <21 22>;
            layers = <NUM>;
            bindings = <&kp NUMBER_0>;
        };

        combo_num_23_dot {
            timeout-ms = <50>;
            key-positions = <22 23>;
            layers = <NUM>;
            bindings = <&kp DOT>;
        };

        combo_num_45_minus {
            timeout-ms = <50>;
            key-positions = <11 12>;
            layers = <NUM>;
            bindings = <&kp MINUS>;
        };

        combo_num_56_plus {
            timeout-ms = <50>;
            key-positions = <12 13>;
            layers = <NUM>;
            bindings = <&kp LS(EQUAL)>;
        };

        combo_num_78_slash {
            timeout-ms = <50>;
            key-positions = <1 2>;
            layers = <NUM>;
            bindings = <&kp SLASH>;
        };

        combo_num_89_asterisk {
            timeout-ms = <50>;
            key-positions = <2 3>;
            layers = <NUM>;
            bindings = <&kp LS(NUMBER_8)>;
        };
    };
 
};
